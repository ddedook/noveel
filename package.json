{
  "name": "noveel",
  "version": "0.1.0",
  "description": "AI novel writing desktop app",
  "main": "./out/main/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev -w",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test:projection": "node --experimental-strip-types --test lib/main/dsh/chat-projection.test.ts",
    "postinstall": "pnpm exec electron-builder install-app-deps && pnpm --filter @noveel/plugin-host build",
    "sync:vendor": "node scripts/sync-vendor-runtime.mjs --write",
    "check:vendor": "node scripts/sync-vendor-runtime.mjs --check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.17",
    "@assistant-ui/react-markdown": "^0.14.13",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/view": "^6.43.9",
    "@electric-sql/pglite": "^0.4.5",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/inter": "^5.3.0",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@hookform/resolvers": "^5.9.1",
    "@noveel/cursor-subscription": "workspace:*",
    "@noveel/plugin-host": "workspace:*",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "^1.170.1",
    "@tanstack/router-plugin": "^1.168.2",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "react-hook-form": "^7.87.0",
    "tailwind-merge": "^3.4.0",
    "tw-shimmer": "^0.4.12",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "cross-env": "^10.1.0",
    "electron": "40.10.6",
    "electron-builder": "^26.7.0",
    "electron-vite": "^5.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
